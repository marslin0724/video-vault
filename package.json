{
  "name": "video-vault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run copy:ffmpeg && vite",
    "build": "npm run copy:ffmpeg && vue-tsc --noEmit && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "copy:ffmpeg": "node scripts/copy-ffmpeg.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
